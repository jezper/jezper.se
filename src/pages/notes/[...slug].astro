---
import { getCollection, type CollectionEntry } from 'astro:content';
import ProseLayout from '@components/layout/ProseLayout.astro';
import EntryHeader from '@components/content/EntryHeader.astro';
import EditedMarker from '@components/content/EditedMarker.astro';
import DiscussLink from '@components/content/DiscussLink.astro';
import { readingTime } from '@lib/readingTime';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map(note => ({ params: { slug: note.slug }, props: { note } }));
}

interface Props { note: CollectionEntry<'notes'>; }
const { note } = Astro.props;
const { Content, rawContent } = await note.render();
const minutes = readingTime(rawContent ? rawContent() : '');
---
<ProseLayout title={note.data.title ?? `Note · ${note.data.date.toISOString().slice(0, 10)}`} description={note.data.description} ogImage={note.data.ogImage}>
  <EntryHeader
    type="note"
    title={note.data.title}
    date={note.data.date}
    tags={note.data.tags}
    externalUrl={note.data.externalUrl}
    readingMinutes={minutes}
  />
  <Content />
  {note.data.externalUrl && (
    <p class="source">Source: <a href={note.data.externalUrl}>{new URL(note.data.externalUrl).hostname} ↗</a></p>
  )}
  <EditedMarker updated={note.data.updated} />
  <DiscussLink url={note.data.discussUrl} />
</ProseLayout>

<style>
  .source { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--ink-muted); margin-top: var(--space-5); }
  .source a { color: var(--ink-muted); }
  .source a:hover { color: var(--accent); }
</style>
