---
import { getCollection } from 'astro:content';
import IndexLayout from '@components/layout/IndexLayout.astro';
import NoteCard from '@components/content/NoteCard.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date);
---
<IndexLayout
  title="Notes"
  intro="Short posts. Linkblog entries, half-thoughts, things noticed. Subscribe via the notes-only RSS feed."
>
  <ol class="list">
    {notes.map(note => {
      const excerpt = note.body.split('\n').find(l => l.trim().length > 0)?.slice(0, 140);
      return (
        <li>
          <NoteCard
            slug={note.slug}
            date={note.data.date}
            title={note.data.title}
            externalUrl={note.data.externalUrl}
            tags={note.data.tags}
            excerpt={excerpt}
            type="note"
          />
        </li>
      );
    })}
  </ol>

  {notes.length === 0 && <p>No notes yet.</p>}
</IndexLayout>

<style>
  .list { list-style: none; padding: 0; margin: 0; }
</style>
