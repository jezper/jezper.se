---
import { getCollection, type CollectionEntry } from 'astro:content';
import ProseLayout from '@components/layout/ProseLayout.astro';
import EntryHeader from '@components/content/EntryHeader.astro';
import EditedMarker from '@components/content/EditedMarker.astro';
import DiscussLink from '@components/content/DiscussLink.astro';
import { readingTime } from '@lib/readingTime';

export async function getStaticPaths() {
  const articles = await getCollection('writing', ({ data }) => !data.draft);
  return articles.map(article => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props { article: CollectionEntry<'writing'>; }
const { article } = Astro.props;
const { Content, rawContent } = await article.render();
const minutes = readingTime(rawContent ? rawContent() : '');
---
<ProseLayout title={article.data.title} description={article.data.description} ogImage={article.data.ogImage}>
  <EntryHeader
    type="article"
    title={article.data.title}
    subtitle={article.data.subtitle}
    date={article.data.date}
    tags={article.data.tags}
    readingMinutes={minutes}
  />
  <Content />
  <EditedMarker updated={article.data.updated} />
  <DiscussLink url={article.data.discussUrl} />
</ProseLayout>
