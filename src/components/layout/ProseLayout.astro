---
import '@styles/prose.css';
import BaseLayout from '@components/layout/BaseLayout.astro';
import Container from '@components/primitives/Container.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: 'article' | 'website';
  ogImage?: string;
}
const { title, description, ogType = 'article', ogImage } = Astro.props;
---
<BaseLayout title={title} description={description} ogType={ogType} ogImage={ogImage}>
  <Container width="content">
    <article class="prose">
      <slot />
    </article>
  </Container>
</BaseLayout>
