---
import { formatDateShort, formatIsoDate } from '@lib/formatDate';
import Tag from '@components/content/Tag.astro';

interface Props {
  slug: string;
  date: Date;
  title?: string;
  externalUrl?: string;
  tags: string[];
  excerpt?: string;
  type: 'note' | 'article';
}
const { slug, date, title, externalUrl, tags, excerpt, type } = Astro.props;
const onSitePath = type === 'article' ? `/writing/${slug}/` : `/notes/${slug}/`;
const titleHref = externalUrl ?? onSitePath;
const isLink = !!externalUrl;
const displayTitle = title ?? excerpt ?? '(untitled)';
---
<article class="row">
  <a href={onSitePath} class="date">
    <time datetime={formatIsoDate(date)}>{formatDateShort(date)}</time>
  </a>
  <a class="title" href={titleHref}>
    {displayTitle}{isLink && <span class="ext" aria-hidden="true"> ↗</span>}
  </a>
  {tags.length > 0 && (
    <ul class="tags">
      {tags.map(t => <li><Tag name={t} /></li>)}
    </ul>
  )}
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    grid-template-rows: auto auto;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }
  .date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    text-decoration: none;
  }
  .date:hover { color: var(--accent); }
  .title { color: var(--ink); text-decoration: none; }
  .title:hover { color: var(--accent); }
  .ext { color: var(--ink-faint); font-size: 0.85em; }
  .tags { grid-column: 2 / -1; display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-1); }
  @media (max-width: 600px) {
    .row { grid-template-columns: 5.5rem 1fr; gap: var(--space-1) var(--space-2); }
  }
</style>
