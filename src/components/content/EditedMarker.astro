---
import { formatDate, formatIsoDate } from '@lib/formatDate';
interface Props { updated?: Date; }
const { updated } = Astro.props;
---
{updated && (
  <p class="edited">
    Updated <time datetime={formatIsoDate(updated)}>{formatDate(updated)}</time>
  </p>
)}

<style>
  .edited {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    margin-top: var(--space-7);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }
</style>
