---
import Kicker from '@components/content/Kicker.astro';
import Tag from '@components/content/Tag.astro';
import { formatDate, formatIsoDate } from '@lib/formatDate';

interface Props {
  type: 'note' | 'article';
  title?: string;
  subtitle?: string;
  date: Date;
  tags: string[];
  readingMinutes?: number;
  externalUrl?: string;
}
const { type, title, subtitle, date, tags, readingMinutes, externalUrl } = Astro.props;
const kicker = type === 'article' ? `Essay · ${date.getUTCFullYear()}` : externalUrl ? `Link · ${date.getUTCFullYear()}` : `Note · ${date.getUTCFullYear()}`;
---
<header class="entry-header">
  <Kicker>{kicker}</Kicker>
  {title && (
    <h1 class={type === 'article' ? 'title display' : 'title'}>
      {externalUrl
        ? <a href={externalUrl}>{title} <span class="ext" aria-hidden="true">↗</span></a>
        : title}
    </h1>
  )}
  {subtitle && <p class="subtitle">{subtitle}</p>}
  <div class="meta">
    <time datetime={formatIsoDate(date)}>{formatDate(date)}</time>
    {readingMinutes && <><span aria-hidden="true">·</span><span>{readingMinutes} min</span></>}
    {tags.length > 0 && <>
      <span aria-hidden="true">·</span>
      <ul class="tags">{tags.map(t => <li><Tag name={t} /></li>)}</ul>
    </>}
  </div>
</header>

<style>
  .entry-header { padding-block: var(--space-6) var(--space-5); border-bottom: 1px solid var(--rule); margin-bottom: var(--space-7); }
  .title { font-size: var(--text-2xl); font-weight: 600; line-height: var(--leading-snug); margin-top: var(--space-3); }
  .title.display { font-family: var(--font-display); font-weight: 800; font-size: var(--text-3xl); line-height: var(--leading-tight); }
  .title a { color: var(--ink); text-decoration: none; }
  .title a:hover { color: var(--accent); }
  .ext { color: var(--ink-faint); font-size: 0.7em; }
  .subtitle { font-size: var(--text-md); color: var(--ink-muted); margin-top: var(--space-3); max-width: var(--measure-prose); }
  .meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2);
    font-family: var(--font-mono); font-size: var(--text-xs); color: var(--ink-muted);
    margin-top: var(--space-4);
  }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; }
</style>
