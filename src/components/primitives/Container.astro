---
interface Props {
  width?: 'content' | 'index' | 'full';
  as?: string;
  class?: string;
}
const { width = 'content', as: Tag = 'div', class: className = '' } = Astro.props;
---
<Tag class={`container container--${width} ${className}`}>
  <slot />
</Tag>

<style>
  .container { width: 100%; margin-inline: auto; padding-inline: var(--space-5); }
  .container--content { max-width: var(--width-content); }
  .container--index   { max-width: var(--width-index); }
  .container--full    { max-width: 100%; }
  @media (min-width: 768px) {
    .container { padding-inline: var(--space-6); }
  }
</style>
