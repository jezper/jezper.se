---
interface Props {
  gap?: 1 | 2 | 3 | 4 | 5;
  align?: 'start' | 'center' | 'end' | 'baseline';
  justify?: 'start' | 'center' | 'between' | 'end';
  as?: string;
  class?: string;
}
const { gap = 3, align = 'center', justify = 'start', as: Tag = 'div', class: className = '' } = Astro.props;
---
<Tag class={`cluster cluster--gap-${gap} cluster--align-${align} cluster--justify-${justify} ${className}`}>
  <slot />
</Tag>

<style>
  .cluster { display: flex; flex-wrap: wrap; }
  .cluster--gap-1 { gap: var(--space-1); }
  .cluster--gap-2 { gap: var(--space-2); }
  .cluster--gap-3 { gap: var(--space-3); }
  .cluster--gap-4 { gap: var(--space-4); }
  .cluster--gap-5 { gap: var(--space-5); }
  .cluster--align-start    { align-items: flex-start; }
  .cluster--align-center   { align-items: center; }
  .cluster--align-end      { align-items: flex-end; }
  .cluster--align-baseline { align-items: baseline; }
  .cluster--justify-start   { justify-content: flex-start; }
  .cluster--justify-center  { justify-content: center; }
  .cluster--justify-between { justify-content: space-between; }
  .cluster--justify-end     { justify-content: flex-end; }
</style>
